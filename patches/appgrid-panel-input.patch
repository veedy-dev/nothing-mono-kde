@@ -0,0 +1,130 @@
+/*
+    SPDX-FileCopyrightText: 2026 AppGrid Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "overlayinputregion.h"
+#include <QTest>
+#include <QTemporaryFile>
+#include <QSignalSpy>
+
+// Exercise Qt's actual window geometry, visibility, events and masks without
+// depending on Plasma's private PanelView headers or a running desktop shell.
+class PanelView : public QWindow
+{
+    Q_OBJECT
+public:
+    QMouseEvent *lastPress = nullptr;
+protected:
+    void mousePressEvent(QMouseEvent *event) override { lastPress = event; }
+};
+
+class TestOverlayInputRegion : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void panelHolesAndDragTransitions()
+    {
+        QCOMPARE(QGuiApplication::screens().size(), 2);
+        QWindow overlay;
+        overlay.setScreen(QGuiApplication::screens().at(1));
+        overlay.setFlags(Qt::FramelessWindowHint);
+        overlay.setGeometry(37, 53, 800, 600); // Layer-shell position is not the output origin.
+        overlay.show();
+        OverlayInputRegion input(&overlay);
+        const QPoint origin = overlay.screen()->geometry().topLeft();
+        PanelView panel;
+        panel.setFlags(Qt::FramelessWindowHint);
+        panel.setGeometry(QRect(origin + QPoint(200, 550), QSize(400, 50)));
+        panel.show();
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(300, 575)));
+        QVERIFY(overlay.mask().contains(QPoint(100, 575))); // Outside click beside the dock.
+        QVERIFY(overlay.mask().contains(QPoint(300, 300))); // Launcher remains interactive.
+
+        QSignalSpy dismissals(&input, &OverlayInputRegion::panelPressed);
+        QMouseEvent press(QEvent::MouseButtonPress, QPointF(20, 20), QPointF(220, 570),
+                          Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(&panel, &press);
+        QCOMPARE(panel.lastPress, &press); // The original press reaches the dock, without replay.
+        QCOMPARE(dismissals.count(), 1);
+        QCOMPARE(qvariant_cast<QWindow *>(dismissals.at(0).at(0)), &overlay);
+        QCOMPARE(dismissals.at(0).at(1).toPointF(), press.globalPosition());
+        QMouseEvent rightPress(QEvent::MouseButtonPress, QPointF(20, 20), QPointF(220, 570),
+                               Qt::RightButton, Qt::RightButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(&panel, &rightPress);
+        QCOMPARE(panel.lastPress, &rightPress);
+        QCOMPARE(dismissals.count(), 1);
+
+        QWindow unrelated;
+        unrelated.setGeometry(QRect(origin + QPoint(20, 20), QSize(100, 100)));
+        unrelated.show();
+        QCoreApplication::processEvents();
+        QVERIFY(overlay.mask().contains(QPoint(50, 50)));
+
+        panel.setPosition(origin + QPoint(0, 0));
+        panel.resize(50, 500);
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(25, 250)));
+        QTRY_VERIFY(overlay.mask().contains(QPoint(300, 575)));
+        panel.hide();
+        QTRY_VERIFY(overlay.mask().contains(QPoint(25, 250)));
+        panel.show();
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(25, 250)));
+
+        const QRect card(200, 100, 400, 400);
+        input.setDragRect(card);
+        QCOMPARE(overlay.mask(), QRegion(card));
+        QCoreApplication::sendEvent(&panel, &press);
+        QCOMPARE(panel.lastPress, &press);
+        QCOMPARE(dismissals.count(), 1); // No panel dismissal during DnD.
+        panel.setPosition(origin + QPoint(200, 100));
+        overlay.resize(900, 700);
+        QCoreApplication::processEvents();
+        QCOMPARE(overlay.mask(), QRegion(card)); // Geometry refresh must not end DnD.
+        input.setDragRect({});
+        QVERIFY(!overlay.mask().contains(QPoint(225, 250)));
+        QVERIFY(overlay.mask().contains(QPoint(850, 650)));
+        QVERIFY(overlay.mask().contains(QPoint(25, 250)));
+
+        panel.hide();
+        auto *latePanel = new PanelView;
+        latePanel->setFlags(Qt::FramelessWindowHint);
+        latePanel->setGeometry(QRect(origin + QPoint(700, 0), QSize(100, 100)));
+        latePanel->show();
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(750, 50)));
+        delete latePanel;
+        QTRY_VERIFY(overlay.mask().contains(QPoint(750, 50)));
+
+        overlay.hide();
+        panel.setPosition(origin + QPoint(400, 0));
+        panel.show();
+        overlay.show();
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(425, 250)));
+
+        QCOMPARE(QGuiApplication::screens().size(), 2);
+        auto *otherScreen = QGuiApplication::screens().at(0);
+        overlay.setScreen(otherScreen);
+        overlay.setPosition(otherScreen->geometry().topLeft() + QPoint(37, 53));
+        overlay.show();
+        QTRY_VERIFY(overlay.mask().contains(QPoint(425, 250)));
+        panel.setScreen(otherScreen);
+        panel.setPosition(otherScreen->geometry().topLeft() + QPoint(100, 0));
+        panel.show();
+        QTRY_VERIFY(!overlay.mask().contains(QPoint(125, 250)));
+        QVERIFY(overlay.mask().contains(QPoint(425, 250)));
+    }
+};
+
+int main(int argc, char **argv)
+{
+    QTemporaryFile configuration;
+    if (!configuration.open()) {
+        return 1;
+    }
+    configuration.write(R"({"screens":[{"name":"primary","x":0,"y":0,"width":1000,"height":800},{"name":"left","x":-1200,"y":-200,"width":1200,"height":900}]})");
+    configuration.flush();
+    const QByteArray platform = "offscreen:configfile=" + configuration.fileName().toUtf8();
+    qputenv("QT_QPA_PLATFORM", platform);
+    QGuiApplication app(argc, argv);
+    TestOverlayInputRegion test;
+    return QTest::qExec(&test, argc, argv);
+}
+#include "test_overlayinputregion.moc"
