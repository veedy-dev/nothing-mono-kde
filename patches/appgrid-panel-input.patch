new file mode 100644
--- /dev/null
+++ b/src/overlayinputregion.h
@@ -0,0 +1,113 @@
+/*
+    SPDX-FileCopyrightText: 2026 AppGrid Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QEvent>
+#include <QGuiApplication>
+#include <QRegion>
+#include <QMouseEvent>
+#include <QScreen>
+#include <QTimer>
+#include <QWindow>
+
+// Wayland only: QWindow::setMask changes the input region there, but also
+// clips the visible window on X11. Owned by the fullscreen layer-shell window.
+class OverlayInputRegion : public QObject
+{
+    Q_OBJECT
+public:
+    explicit OverlayInputRegion(QWindow *window)
+        : QObject(window)
+        , m_window(window)
+    {
+        qGuiApp->installEventFilter(this);
+        connect(window, &QWindow::screenChanged, this, &OverlayInputRegion::watchScreen);
+        watchScreen(window->screen());
+    }
+
+    void setDragRect(const QRect &rect)
+    {
+        m_dragRect = rect;
+        refresh();
+    }
+
+Q_SIGNALS:
+    void panelPressed(QWindow *window, const QPointF &globalPosition);
+
+private:
+    void watchScreen(QScreen *screen)
+    {
+        disconnect(m_screenConnection);
+        if (screen) {
+            m_screenConnection = connect(screen, &QScreen::geometryChanged, this, [this]() { refresh(); });
+        }
+        refresh();
+    }
+
+    void refresh()
+    {
+        if (!m_dragRect.isEmpty()) {
+            m_window->setMask(QRegion(m_dragRect));
+            return;
+        }
+        QRegion region(QRect(QPoint(), m_window->size()));
+        if (auto *screen = m_window->screen()) {
+            // All-edge anchors and exclusiveZone=-1 put our surface at the
+            // output origin. Wayland QWindow::position() need not reflect it.
+            const QPoint origin = screen->geometry().topLeft();
+            const auto windows = QGuiApplication::allWindows();
+            for (auto *panel : windows) {
+                if (panel == m_window || !panel->inherits("PanelView")) {
+                    continue;
+                }
+                connect(panel, &QWindow::screenChanged, this, &OverlayInputRegion::refresh, Qt::UniqueConnection);
+                if (panel->isVisible() && panel->screen() == screen) {
+                    region -= panel->geometry().translated(-origin);
+                }
+            }
+        }
+        // Qt treats an empty mask as unrestricted, not as empty input.
+        if (region.isEmpty()) {
+            region = QRegion(-1, -1, 1, 1);
+        }
+        m_window->setMask(region);
+    }
+
+    bool eventFilter(QObject *object, QEvent *event) override
+    {
+        switch (event->type()) {
+        case QEvent::MouseButtonPress:
+            if (m_window->isVisible() && m_dragRect.isEmpty() && object->inherits("PanelView")
+                && static_cast<QWindow *>(object)->screen() == m_window->screen()
+                && static_cast<QMouseEvent *>(event)->button() == Qt::LeftButton) {
+                Q_EMIT panelPressed(m_window, static_cast<QMouseEvent *>(event)->globalPosition());
+            }
+            break;
+        case QEvent::Move:
+        case QEvent::Resize:
+        case QEvent::Show:
+        case QEvent::Hide:
+        case QEvent::PlatformSurface:
+            if ((object == m_window || object->inherits("PanelView")) && !m_refreshPending) {
+                // Show/hide and platform-surface events may precede the new
+                // public state. Coalesce until after the event is delivered.
+                m_refreshPending = true;
+                QTimer::singleShot(0, this, [this]() {
+                    m_refreshPending = false;
+                    refresh();
+                });
+            }
+            break;
+        default:
+            break;
+        }
+        return false;
+    }
+
+    QWindow *const m_window;
+    QRect m_dragRect;
+    QMetaObject::Connection m_screenConnection;
+    bool m_refreshPending = false;
+};
