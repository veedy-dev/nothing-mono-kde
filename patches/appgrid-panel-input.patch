+
+    Connections {
+        target: root.plasmoidBridge.inputSignals || null
+        function onPanelPressed(window, globalPosition) {
+            if (window !== root || !root.visible || root._dragInFlight || !root.appletInterface)
+                return
+            // Our own icon toggles on release. Closing on its press would
+            // make that release reopen the grid; other panel clicks dismiss.
+            const compact = root.appletInterface.compactRepresentationItem
+            if (compact && compact.contains(compact.mapFromGlobal(globalPosition)))
+                return
+            root.appletInterface.closeWindow()
+        }
+    }
 
     ConfigCache { id: cfg; source: root.configuration }
 
